{
  "expo": {
    "name": "Codon",
    "slug": "codon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1.png",
    "splash": {
      "image": "./assets/images/splash-codon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F13"
    },
    "scheme": "codon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codon.learn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.codon.learn"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F13",
          "image": "./assets/images/splash-codon.png",
          "dark": {
            "image": "./assets/images/splash-codon.png",
            "backgroundColor": "#0F0F13"
          },
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f267cc1-014c-4b37-974b-446337ba8990"
      }
    },
    "owner": "vlmlokesh22"
  }
}

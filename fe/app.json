{
  "expo": {
    "name": "Codon",
    "slug": "codon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codon.app"
    },
    "android": {
      "package": "com.codon.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f267cc1-014c-4b37-974b-446337ba8990"
      }
    },
    "owner": "vlmlokesh22"
  }
}

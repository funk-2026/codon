{
  "expo": {
    "name": "Codon",
    "slug": "codon",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1.png",
    "scheme": "codon",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codon.learn",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.codon.learn",
      "versionCode": 4,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2447",
          "image": "./assets/images/splash-codon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Codon needs access to your photos so you can attach images to questions.",
          "cameraPermission": "Codon needs the camera so you can photograph a diagram for a question."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12306B"
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "serverUrl": "https://api-v2.codonneetug.com",
      "router": {},
      "eas": {
        "projectId": "5f267cc1-014c-4b37-974b-446337ba8990"
      }
    },
    "owner": "vlmlokesh22"
  }
}

# ─── Codon App Release Configuration ──────────────────────────────────────────

# Build Number should always be incremented for each build
# Android (Google Play Store)
# ANDROID_VERSION_NAME: Semantic version shown to users (e.g. 1.0.0)
# ANDROID_VERSION_CODE: Positive integer strictly incremented for each Play Store upload
ANDROID_VERSION_NAME=26.11.1
ANDROID_VERSION_CODE=5

# iOS (Apple App Store & TestFlight)
# IOS_VERSION_NAME: Semantic version shown in the App Store (CFBundleShortVersionString)
# IOS_BUILD_NUMBER: Strictly incrementing build number (CFBundleVersion)
# For testing testflight use version 99.0.0
IOS_VERSION_NAME=26.11.1
IOS_BUILD_NUMBER=5

# ─── Backend Server Configuration ─────────────────────────────────────────────
# Base URL for the backend API server.
# The app will automatically append /api/v1 if not present.
server_url=https://api-v2.codonneetug.com
SERVER_URL=https://api-v2.codonneetug.com
EXPO_PUBLIC_SERVER_URL=https://api-v2.codonneetug.com



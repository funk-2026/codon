# ─── Codon App Release Configuration ──────────────────────────────────────────

# Android (Google Play Store)
# ANDROID_VERSION_NAME: Semantic version shown to users (e.g. 1.0.0)
# ANDROID_VERSION_CODE: Positive integer strictly incremented for each Play Store upload
ANDROID_VERSION_NAME=1.0.0
ANDROID_VERSION_CODE=1

# iOS (Apple App Store & TestFlight)
# IOS_VERSION_NAME: Semantic version shown in the App Store (CFBundleShortVersionString)
# IOS_BUILD_NUMBER: Strictly incrementing build number (CFBundleVersion)
IOS_VERSION_NAME=1.0.0
IOS_BUILD_NUMBER=1


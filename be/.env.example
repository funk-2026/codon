# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://codon:codon@localhost:5432/codon?sslmode=disable

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRY_DAYS=90

# ─── 2Factor.in OTP ───────────────────────────────────────────────────────────
# Leave blank to use console-logging stub (for local dev)
TWO_FACTOR_API_KEY=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── S3 / R2 Object Storage ───────────────────────────────────────────────────
# For Cloudflare R2, set S3_ENDPOINT to your R2 endpoint
# Leave S3_ACCESS_KEY_ID blank to use the stub presign response in local dev
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=codon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Bunny Stream (video upload/transcode) ──────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_SECONDS=5

# ─── Rate Limiting ────────────────────────────────────────────────────────────
OTP_RATE_LIMIT_PER_HOUR=3

# ─── App Store / Google Play Reviewer Test Login ──────────────────────────────
# Reviewers cannot receive physical SMS. Setting these allows testing with a fixed OTP.
# Note: Phone number MUST include the +91 country code (as sent by the app).
REVIEWER_PHONE_NUMBER=+919999999999
REVIEWER_OTP_CODE=123456


# ─── Database pool / safety net ───────────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
# Abort queries running longer than this (ms). 0 = off. Recommended in production for the API: 15000
DB_STATEMENT_TIMEOUT_MS=0

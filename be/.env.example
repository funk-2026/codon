# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://codon:codon@localhost:5432/codon?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRY_DAYS=90

# ─── 2Factor.in OTP ───────────────────────────────────────────────────────────
# Leave blank to use console-logging stub (for local dev)
TWO_FACTOR_API_KEY=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── S3 / R2 Object Storage ───────────────────────────────────────────────────
# For Cloudflare R2, set S3_ENDPOINT to your R2 endpoint
# Leave S3_ACCESS_KEY_ID blank to use the stub presign response in local dev
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=codon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Cloudflare Stream (video upload/transcode) ──────────────────────────────
# Leave blank to fall back to raw R2 upload with no real transcoding (dev stub)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_SECONDS=5

# ─── Rate Limiting ────────────────────────────────────────────────────────────
OTP_RATE_LIMIT_PER_HOUR=3
